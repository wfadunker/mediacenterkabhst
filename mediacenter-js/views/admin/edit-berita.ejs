
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Edit Berita - Admin Media Center HST</title>
    <link rel="stylesheet" href="<%= baseUrl %>/assets/css/admin.css?v=20261102">
</head>
<body class="admin-dashboard-page">

<%- include('../partials/sidebar') %>

<main class="admin-main">
<div class="admin-container">

    <!-- PAGE HEADER -->
    <header class="page-header">
        <div>
            <p class="eyebrow">Pengelolaan Berita</p>
            <h1>Edit Berita</h1>
            <p>Perbarui isi, metadata, dan gambar berita.</p>
        </div>

        <div class="page-actions">
            <a href="<%= baseUrl %>/detail?slug=<%= encodeURIComponent(data.slug) %>"
               target="_blank" rel="noopener" class="btn btn-secondary">
                Lihat Berita ↗
            </a>
            <a href="<%= baseUrl %>/admin/berita" class="btn btn-secondary">← Kembali</a>
        </div>
    </header>

    <!-- ERROR -->
    <% if (errors.length) { %>
        <div class="error-box" role="alert">
            <strong>Data belum dapat disimpan.</strong>
            <% for (const error of errors) { %>
                <p>• <%= error %></p>
            <% } %>
        </div>
    <% } %>

    <!-- FORM -->
    <form method="post" enctype="multipart/form-data" class="form-layout">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

        <!-- KOLOM KIRI -->
        <div class="form-main">

            <section class="form-card">
                <div class="form-card-head">
                    <h2 class="form-card-title">Isi Berita</h2>
                    <p class="form-card-desc">
                        Perbarui judul dan isi berita yang ditampilkan kepada masyarakat.
                    </p>
                </div>

                <div class="form-group">
                    <label for="judul" class="form-label">
                        Judul Berita <span class="required">*</span>
                    </label>
                    <input id="judul" type="text" name="judul"
                           value="<%= data.judul %>"
                           required class="form-control">
                </div>

                <div class="form-group">
                    <label for="isi" class="form-label">
                        Isi Berita <span class="required">*</span>
                    </label>
                    <textarea id="isi" name="isi" required rows="10"
                              class="form-control"><%= data.isi %></textarea>
                    <p class="form-help">
                        Gunakan Enter untuk membuat paragraf baru.
                    </p>
                </div>
            </section>

            <section class="form-card">
                <div class="form-card-head">
                    <h2 class="form-card-title">Informasi Publikasi</h2>
                    <p class="form-card-desc">
                        Data ini ditampilkan sebagai informasi pendukung pada halaman berita.
                    </p>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="kategori" class="form-label">
                            Kategori <span class="required">*</span>
                        </label>
                        <input id="kategori" type="text" name="kategori"
                               list="kategori-list"
                               value="<%= data.kategori %>"
                               required class="form-control">
                        <datalist id="kategori-list">
                            <option value="Pemerintahan">
                            <option value="Pelayanan Publik">
                            <option value="Pendidikan">
                            <option value="Sosial">
                            <option value="Keagamaan">
                            <option value="Informasi">
                            <option value="Komunikasi">
                            <option value="Teknologi">
                            <option value="Agenda">
                        </datalist>
                    </div>

                    <div class="form-group">
                        <label for="tanggal" class="form-label">
                            Tanggal Publikasi <span class="required">*</span>
                        </label>
                        <input id="tanggal" type="date" name="tanggal"
                               value="<%= data.tanggal %>"
                               required class="form-control">
                    </div>

                    <div class="form-group">
                        <label for="penulis" class="form-label">Penulis</label>
                        <input id="penulis" type="text" name="penulis"
                               value="<%= data.penulis||'Media Center HST' %>"
                               class="form-control">
                    </div>

                    <div class="form-group">
                        <label for="sumber" class="form-label">Sumber</label>
                        <input id="sumber" type="text" name="sumber"
                               value="<%= data.sumber||'Diskominfo HST' %>"
                               class="form-control">
                    </div>
                </div>
            </section>

        </div>

        <!-- SIDEBAR KANAN -->
        <aside class="form-sidebar">

            <section class="form-card">
                <div class="form-card-head">
                    <h2 class="form-card-title">Gambar Berita</h2>
                    <p class="form-card-desc">
                        Gambar akan digunakan pada halaman publik.
                    </p>
                </div>

                <% if (data.gambar) { %>
                    <div class="image-preview">
                        <img src="<%= baseUrl %>/assets/img/<%= data.gambar %>"
                             alt="<%= data.judul %>">
                    </div>

                    <label class="check-row">
                        <input type="checkbox" name="hapus_gambar" value="1">
                        <span>Hapus gambar saat disimpan</span>
                    </label>
                <% } else { %>
                    <div class="image-preview">
                        <div class="image-empty">Belum ada gambar</div>
                    </div>
                <% } %>

                <input type="file" name="gambar"
                       accept=".jpg,.jpeg,.png,.webp" class="file-input">

                <p class="form-help">
                    JPG, PNG, atau WebP. Maksimal 2 MB.
                    Kosongkan jika gambar tidak ingin diganti.
                </p>
            </section>

            <section class="form-card">
                <div class="form-card-head">
                    <h2 class="form-card-title">Informasi Berita</h2>
                </div>

                <div class="meta-list">
                    <div class="meta-row">
                        <span>ID</span>
                        <strong>#<%= data.id %></strong>
                    </div>
                    <div class="meta-row">
                        <span>Slug</span>
                        <strong class="meta-slug"><%= data.slug %></strong>
                    </div>
                    <div class="meta-row">
                        <span>Terakhir Update</span>
                        <strong><%= waktuAdmin(data.updated_at) %></strong>
                    </div>
                </div>

                <button type="submit" class="form-submit">
                    Simpan Perubahan
                </button>
            </section>

        </aside>
    </form>

</div>
</main>

</body>
</html>