
<!-- FOOTER MEDIA CENTER HST -->

< class="mc-public-footer">
  <div class="mc-public-footer__inner">

    <div class="mc-public-footer__grid">

      <!-- LOKASI -->
      <section class="mc-public-footer__section"
        aria-labelledby="footer-maps">

        <p class="mc-public-footer__eyebrow">Lokasi</p>
        <h2 class="mc-public-footer__title" id="footer-maps">
          Maps
        </h2>

        <div class="mc-public-footer__map">
          <iframe
            title="Peta lokasi Dinas Komunikasi dan Informatika Kabupaten Hulu Sungai Tengah"
            src="https://www.google.com/maps?q=Dinas+Komunikasi+dan+Informatika+Kabupaten+Hulu+Sungai+Tengah&output=embed"
            width="100%"
            height="230"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen>
          </iframe>
        </div>

        <p class="mc-public-footer__muted">
          Dinas Komunikasi dan Informatika Kabupaten Hulu Sungai Tengah.
        </p>

      </section>

      <!-- LINK TERKAIT -->
      <section class="mc-public-footer__section"
        aria-labelledby="footer-links">

        <p class="mc-public-footer__eyebrow">Referensi</p>
        <h2 class="mc-public-footer__title" id="footer-links">
          Link Terkait
        </h2>

        <nav class="mc-public-footer__links"
          aria-label="Tautan resmi terkait">

          <a href="https://www.komdigi.go.id/"
            target="_blank"
            rel="noopener noreferrer">
            <span>Komdigi</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a href="https://cekhoaks.aduankonten.id/"
            target="_blank"
            rel="noopener noreferrer">
            <span>Cek Hoaks</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a href="https://www.lapor.go.id/"
            target="_blank"
            rel="noopener noreferrer">
            <span>SP4N-LAPOR!</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a href="https://mc.kalselprov.go.id/"
            target="_blank"
            rel="noopener noreferrer">
            <span>Media Center Kalimantan Selatan</span>
            <span aria-hidden="true">↗</span>
          </a>

          <a href="https://www.hstkab.go.id/"
            target="_blank"
            rel="noopener noreferrer">
            <span>Portal Kabupaten Hulu Sungai Tengah</span>
            <span aria-hidden="true">↗</span>
          </a>

        </nav>

      </section>

      <!-- KONTAK -->
      <section class="mc-public-footer__section"
        aria-labelledby="footer-contact">

        <p class="mc-public-footer__eyebrow">Informasi</p>
        <h2 class="mc-public-footer__title" id="footer-contact">
          Kontak Kami
        </h2>

        <div class="mc-public-footer__contact">

          <!-- ALAMAT -->
          <div class="mc-public-footer__contact-row">

            <span class="mc-public-footer__contact-icon"
              aria-hidden="true">

              <svg viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.8">
                <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/>
                <circle cx="12" cy="10" r="2.5"/>
              </svg>

            </span>

            <div>
              <p class="mc-public-footer__label">Alamat</p>
              <p>
                Jl. Perintis Kemerdekaan, Benawa Tengah,
                Barabai, Kabupaten Hulu Sungai Tengah,
                Kalimantan Selatan 71314
              </p>
            </div>

          </div>

          <!-- TELEPON -->
          <div class="mc-public-footer__contact-row">

            <span class="mc-public-footer__contact-icon"
              aria-hidden="true">

              <svg viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.8">
                <path d="M6.5 3.5 9 8l-2 2c1.5 3 3.5 5 6.5 6.5l2-2L20 17c-.5 2.5-2 4-4.5 4C9 21 3 15 3 8.5 3 6 4.5 4 6.5 3.5Z"/>
              </svg>

            </span>

            <div>
              <p class="mc-public-footer__label">Telepon</p>
              <p>
                <a href="tel:05173790845">
                  (0517) 3790845
                </a>
              </p>
            </div>

          </div>

          <!-- EMAIL -->
          <div class="mc-public-footer__contact-row">

            <span class="mc-public-footer__contact-icon"
              aria-hidden="true">

              <svg viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="m4 7 8 6 8-6"/>
              </svg>

            </span>

            <div>
              <p class="mc-public-footer__label">Email</p>
              <p>
                <a href="mailto:diskominfo@hstkab.go.id">
                  diskominfo@hstkab.go.id
                </a>
              </p>
            </div>

          </div>

        </div>

      </section>

    </div>

    <!-- COPYRIGHT -->
    <div class="mc-public-footer__bottom">

      <p>
        © <%= new Date().getFullYear() %>
        Media Center Kabupaten Hulu Sungai Tengah
      </p>

      <p>
        Pemerintah Kabupaten Hulu Sungai Tengah
      </p>

    </div>

  </div>

</footer>

<!-- ACCESSIBILITY WIDGET -->
<%- include('./accessibility.ejs') %>

<!-- ACCESSIBILITY JAVASCRIPT -->
<script
  src="<%= baseUrl %>/assets/js/acse.js?v=12"
  defer>
</script>

</body>
</html>




