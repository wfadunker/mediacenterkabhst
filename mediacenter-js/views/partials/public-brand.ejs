

<header class="mc-app-brand">

    <!-- IDENTITAS PEMERINTAH -->
    <div class="mc-brand-left">

        <img
            src="<%= baseUrl %>/assets/img/logo-hst.png"
            alt="Logo Kabupaten Hulu Sungai Tengah"
            class="mc-brand-logo"
            width="50"
            height="50"
            decoding="async"
        >

        <div class="mc-brand-text">

            <span>
                Pemerintah Kabupaten
            </span>

            <strong>
                Hulu Sungai Tengah
            </strong>

            <em>
                Media Center
            </em>

        </div>

    </div>


    <!-- TANGGAL DAN JAM -->
    <div class="mc-brand-time">

        <span>
            <%= tanggalFull %>
        </span>

        <strong
            class="js-mc-clock"
        >
            <%= jamFull %>
        </strong>

    </div>

</header>
